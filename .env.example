# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored and must never be committed.
# Spring Boot loads it via `spring.config.import` in each service's
# application.properties, so plain KEY=value lines are all that's needed.

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chessable
DB_USERNAME=springuser
DB_PASSWORD=changeme

# ---- RabbitMQ ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
